# Claude API 키 (https://platform.claude.com)
ANTHROPIC_API_KEY=

# MongoDB 연결 문자열 (DB 이름 포함). 예: mongodb+srv://user:pass@cluster.mongodb.net/ai-chat
MONGODB_URI=

# npx auth secret 으로 생성
AUTH_SECRET=

# Google OAuth (콜백: http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (콜백: http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
